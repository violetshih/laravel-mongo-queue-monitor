{
  "version": "6.0.0",
  "name": "violetshih/laravel-mongo-queue-monitor",
  "description": "Queue Monitoring for Laravel MongoDb Job Queue",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "violetshih",
      "email": "swam1991@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-mbstring": "*",
    "illuminate/database": "^13.0",
    "illuminate/queue": "^13.0",
    "illuminate/support": "^13.0",
    "mongodb/laravel-mongodb": "^5.11",
    "nesbot/carbon": "^3.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "violetshih\\MongoQueueMonitor\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "violetshih\\MongoQueueMonitor\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "violetshih\\MongoQueueMonitor\\Providers\\MongoQueueMonitorProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
